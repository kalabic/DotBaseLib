<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DotBase</AssemblyName>
    <Version>1.13.0</Version>
    <Authors>silvije</Authors>
    <Copyright>Copyright © Silvije Kalabic 2025, 2026 All rights reserved.</Copyright>
    <PackageProjectUrl>https://github.com/kalabic/DotBaseLib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kalabic/DotBaseLib</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>DotBase</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="**\README.md" />

    <None Include="..\..\doc\package\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotBaseLib.Tests" />
  </ItemGroup>

</Project>
